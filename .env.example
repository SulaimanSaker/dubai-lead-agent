# Copy to .env.local and fill in. Never commit .env.local.

# Local SQLite database (create it with `npm run db:seed`)
DATABASE_URL=file:local.db

# Which model runs the agent: "claude" or "local"
LLM_PROVIDER=local

# Claude (Anthropic API) — needed when LLM_PROVIDER=claude and for the eval judge
ANTHROPIC_API_KEY=
# Optional (defaults shown). Effort: low | medium | high | xhigh | max
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low

# Local model in LM Studio (start its server first)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-3-4b

# Tracing (Langfuse) — optional. Off when the keys are empty.
# Keys: Langfuse project → Settings → API Keys. EU cloud below; US: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Set to "off" to disable tracing even with keys set
LANGFUSE_TRACING=on
